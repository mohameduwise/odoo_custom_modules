<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_eagles_assessment_report" model="ir.actions.report">
        <field name="name">EAGLES Assessment Report</field>
        <field name="model">survey.user_input</field>
        <field name="paperformat_id" ref="instix_customisations.paperformat_custom_a4_low_margin"/>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">instix_customisations.report_eagles_assessment</field>
        <field name="report_file">
            EAGLES_Assessment_${(object and object.partner_id and object.partner_id.name) or 'Report'}
        </field>
        <field name="binding_model_id" ref="survey.model_survey_user_input"/>
        <field name="binding_type">report</field>
    </record>

    <record id="paperformat_custom_a4_low_margin" model="report.paperformat">
        <field name="name">Custom A4 - Low Top Margin</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line">True</field>
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
        <field name="disable_shrinking">True</field>
    </record>


</odoo>
