<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="deposit_invoice_global_styles">
        <style>
            .page {
                margin-top: 0 !important;
                padding-top: 0 !important;
                position: relative;
            }
            .article {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }
            .o_report_layout_standard {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }
            .header + .article {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }
            .header {
                margin-bottom: 0 !important;
                padding-bottom: 0 !important;
            }
        </style>
    </template>

    <template id="deposit_invoice_header_footer_template" name="Custom Quotation Header Footer">

        <t t-call="instix_customisations.deposit_invoice_global_styles"/>

        <t t-set="is_layang" t-value="'LAYANG' in (doc.company_id.name or '').upper()"/>
        <t t-set="header_b64"
           t-value="doc._get_report_image_b64_deposit_invoice('header_layang.png') if is_layang else doc._get_report_image_b64_deposit_invoice('header_insytx.png')"/>
        <t t-set="footer_b64"
           t-value="doc._get_report_image_b64_deposit_invoice('footer_layang.png') if is_layang else doc._get_report_image_b64_deposit_invoice('footer_insytx.png')"/>

        <!-- HEADER -->
        <div class="header" style="margin:0; padding:0;">
            <img t-att-src="header_b64" style="width:100%; display:block;"/>
        </div>

        <!-- MAIN CONTENT AREA -->
        <div class="article o_report_layout_standard"
             style="margin-top:0 !important; padding-top:0 !important;">
            <t t-out="0"/>
        </div>

        <!-- FOOTER -->
        <div class="footer" style="width:100%; position:relative; margin-top:5mm;">
            <img t-att-src="footer_b64" style="width:100%; display:block;"/>
            <div style="position:absolute; top:8px; left:15px; font-size:8pt; color:#666; font-family:'Urbanist', Arial, sans-serif;">
                Page
                <span class="page"/>
                of
                <span class="topage"/>
            </div>
        </div>

    </template>
    <template id="report_deposit_invoice_document">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">
                <t t-set="is_layang" t-value="'LAYANG' in (doc.company_id.name or '').upper()"/>
                <t t-set="seal_b64"
                   t-value="doc._get_report_image_b64_deposit_invoice('Layang Seal.jpg') if is_layang else doc._get_report_image_b64_deposit_invoice('Digital Seal.jpg')"/>
                <t t-set="deposit_b64" t-value="doc._get_report_image_b64_deposit_invoice('deposit_invoice.png')"/>

                <t t-call="instix_customisations.deposit_invoice_header_footer_template">

                    <div class="page"
                         style="font-family: 'Urbanist', 'Arial', sans-serif; font-size: 9pt; color: #3f403e; margin:0; padding:0; position:relative; box-sizing:border-box;">

                        <!-- ================= INVOICE DETAILS + IMAGE ================= -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:3mm; font-size:9pt;">
                            <tr>
                                <!-- LEFT: Invoice To -->
                                <td style="width:45%; vertical-align:top; padding-right:6px;">
                                    <span style="font-weight:700; color:#000;">Invoice To:</span>
                                    <br/>
                                    <span t-field="doc.partner_id.name"/>
                                    <br/>
                                    <t t-if="doc.partner_id.street">
                                        <span t-field="doc.partner_id.street"/>
                                        <br/>
                                    </t>
                                    <t t-if="doc.partner_id.city">
                                        <span t-field="doc.partner_id.city"/>
                                        <br/>
                                    </t>
                                    <t t-if="doc.partner_id.country_id">
                                        <span t-field="doc.partner_id.country_id"/>
                                    </t>
                                </td>

                                <!-- MIDDLE: Invoice Info -->
                                <td style="width:43%; vertical-align:top;">
                                    <table style="width:100%; border-collapse:collapse; font-size:9pt;">
                                        <tr>
                                            <td style="width:42%; padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Invoice Num:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Invoice Date:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.invoice_date"
                                                      t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Reference:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.ref"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Payment Terms:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.invoice_payment_term_id"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Due On:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.invoice_date_due"
                                                      t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>

                                <!-- RIGHT: DEPOSIT INVOICE IMAGE -->
                                <td style="width:12%; vertical-align:top; text-align:right; padding-right:0mm;">
                                    <img t-att-src="deposit_b64"
                                         style="width:85%; height:auto; display:block; margin-left:auto;"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ================= SUBJECT ================= -->
                            <p style="margin:0 0 3mm 0; font-size:9pt; font-weight:700; color:#000;">
                                SUBJECT:
                                <span t-field="doc.x_studio_subject" style="font-weight:700;"/>
                            </p>

                        <!-- ================= INVOICE LINES TABLE ================= -->
                        <table style="width:100%; border-collapse:collapse; font-size:9pt; margin-bottom:4mm;">
                            <thead>
                                <tr style="border-bottom:1.5px solid #3f403e;">
                                    <th style="text-align:left; padding:3px 4px 3px 0; width:35%; font-weight:700; color:#000;">
                                        Description
                                    </th>
                                    <th style="text-align:left; padding:3px 4px; width:20%; font-weight:700; color:#000;">
                                        Account
                                    </th>
                                    <th style="text-align:center; padding:3px 4px; width:10%; font-weight:700; color:#000;">
                                        Qty
                                    </th>
                                    <th style="text-align:right; padding:3px 4px; width:15%; font-weight:700; color:#000;">
                                        Unit Price
                                    </th>
                                    <th style="text-align:right; padding:3px 4px; width:10%; font-weight:700; color:#000;">
                                        Tax
                                    </th>
                                    <th style="text-align:right; padding:3px 0 3px 4px; width:10%; font-weight:700; color:#000;">
                                        Amount RM
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td style="padding:3px 4px 3px 0; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="padding:3px 4px; vertical-align:top; border-bottom:0.5px solid #e8e8e8; font-size:8pt; color:#555;">
                                            <t t-out="line.account_id.code"/>
                                            -
                                            <t t-out="line.account_id.name"/>
                                        </td>
                                        <td style="padding:3px 4px; text-align:center; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.quantity"/>
                                            <t t-if="line.product_uom_id">
                                                <span t-field="line.product_uom_id"/>
                                            </t>
                                        </td>
                                        <td style="padding:3px 4px; text-align:right; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td style="padding:3px 4px; text-align:right; vertical-align:top; border-bottom:0.5px solid #e8e8e8; font-size:8pt; color:#555;">
                                            <t t-if="line.tax_ids">
                                                <t t-out="', '.join(line.tax_ids.mapped('name'))"/>
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td style="padding:3px 0 3px 4px; text-align:right; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ================= TERMS & CONDITIONS ================= -->
                        <p style="margin:0 0 1.5mm 0; font-size:9pt; font-weight:700; color:#000;">
                            TERMS &amp; CONDITIONS
                        </p>

                        <table style="width:100%; border-collapse:collapse; margin-bottom:3mm;">
                            <tr>
                                <td style="width:56%; vertical-align:top; padding-right:8px; font-size:6pt; line-height:1.45; color:#3f403e;">
                                    1. All Cheque should be made Payable to
                                    <strong>
                                        <span t-field="doc.company_id.name"/>
                                    </strong>
                                    .
                                    <br/>
                                    2. Online Public Bank A/C No: 3984127030 - Until full Payments.
                                    <br/>
                                    3. All Goods supplied remain the Property of
                                    <strong>
                                        <span t-field="doc.company_id.name"/>
                                    </strong>
                                    Until full Payments.
                                    <br/>
                                    4. Discrepancies if any must be reported within 7 days after receipt of Invoice /
                                    D.O.
                                </td>

                                <td style="width:44%; vertical-align:top;">
                                    <table style="width:100%; border-collapse:collapse; font-size:9pt;">
                                        <tr>
                                            <td style="padding:2px 8px 2px 0; font-weight:700; color:#000;">Subtotal
                                            </td>
                                            <td style="padding:2px 0; font-weight:700; color:#000; text-align:right; white-space:nowrap;">
                                                <span t-field="doc.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px 8px 2px 0; color:#3f403e;">Tax</td>
                                            <td style="padding:2px 0; text-align:right; white-space:nowrap; color:#3f403e;">
                                                <span t-field="doc.amount_tax"/>
                                            </td>
                                        </tr>
                                        <tr style="border-top:1px solid #3f403e;">
                                            <td style="padding:3px 8px 2px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Total Amount
                                            </td>
                                            <td style="padding:3px 0 2px 0; font-weight:700; color:#000; text-align:right; white-space:nowrap;">
                                                <span t-field="doc.amount_total"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px 8px 2px 0; color:#3f403e;">Payment Made</td>
                                            <td style="padding:2px 0; text-align:right; white-space:nowrap; color:#3f403e;">
                                                <t t-set="amount_paid"
                                                   t-value="doc.amount_total - doc.amount_residual"/>
                                                <span t-esc="'RM %.2f' % amount_paid"/>
                                            </td>
                                        </tr>
                                        <tr style="border-top:1px solid #3f403e;">
                                            <td style="padding:3px 8px 2px 0; font-weight:700; color:#cc0000; white-space:nowrap;">
                                                Balance Due
                                            </td>
                                            <td style="padding:3px 0 2px 0; font-weight:700; color:#cc0000; text-align:right; white-space:nowrap;">
                                                <span t-field="doc.amount_residual"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- ================= END OF INVOICE ================= -->
                        <p style="text-align:center; font-size:9pt; font-weight:700; color:#000; margin:5mm 0;">
                            End of Invoice Lines
                        </p>

                        <!-- ================= SIGNATURE ================= -->
                        <div style="margin-top:15mm; font-size:8.5pt; color:#3f403e;">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="width:50%; vertical-align:bottom;">
                                        <div style="border-top:1px dashed #3f403e; margin-bottom:3px; width:80%;"/>
                                        Receiver's Signatory (Sign and Chop)
                                    </td>
                                    <td style="width:50%; vertical-align:bottom; text-align:right;">
                                        <img t-att-src="seal_b64"
                                             style="width:40mm; height:40mm; display:block; margin-bottom:5px; margin-left:auto;"/>
                                        <div style="border-top:1px dashed #3f403e; margin-bottom:3px; width:80%; margin-left:auto;"/>
                                        Authorized Signatory
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>