<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="quotation_global_styles">
        <style>
            .page {
                margin-top: 0 !important;
                padding-top: 0 !important;
                position: relative;
            }
            .article {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }
            .o_report_layout_standard {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }
            .header + .article {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }
            .header {
                margin-bottom: 0 !important;
                padding-bottom: 0 !important;
            }
        </style>
    </template>

    <template id="sale_quotation_header_footer_template" name="Custom Quotation Header Footer">

        <t t-call="instix_customisations.quotation_global_styles"/>

        <t t-set="is_layang" t-value="'LAYANG' in (doc.company_id.name or '').upper()"/>
        <t t-set="header_b64"
           t-value="doc._get_report_image_b64('header_layang.png') if is_layang else doc._get_report_image_b64('header_insytx.png')"/>
        <t t-set="footer_b64"
           t-value="doc._get_report_image_b64('footer_layang.png') if is_layang else doc._get_report_image_b64('footer_insytx.png')"/>

        <!-- HEADER -->
        <div class="header" style="margin:0; padding:0;">
            <img t-att-src="header_b64" style="width:100%; display:block;"/>
        </div>

        <!-- MAIN CONTENT AREA -->
        <div class="article o_report_layout_standard"
             style="margin-top:0 !important; padding-top:0 !important;">
            <t t-out="0"/>
        </div>

        <!-- FOOTER -->
        <div class="footer" style="width:100%; position:relative; margin-top:5mm;">
            <img t-att-src="footer_b64" style="width:100%; display:block;"/>
            <div style="position:absolute; top:8px; left:15px; font-size:8pt; color:#666; font-family:'Urbanist', Arial, sans-serif;">
                Page
                <span class="page"/>
                of
                <span class="topage"/>
            </div>
        </div>

    </template>

    <!-- ================= MAIN REPORT ================= -->
    <template id="report_sale_quotation_document">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">
                <t t-set="is_layang" t-value="'LAYANG' in (doc.company_id.name or '').upper()"/>

                <t t-set="quotation_b64" t-value="doc._get_report_image_b64('quotation.png')"/>
                <t t-set="seal_b64"
                   t-value="doc._get_report_image_b64('Layang Seal.jpg') if is_layang else doc._get_report_image_b64('Digital Seal.jpg')"/>
                <t t-call="instix_customisations.sale_quotation_header_footer_template">

                    <div class="page"
                         style="font-family: 'Urbanist', 'Arial', sans-serif; font-size: 9pt; color: #3f403e; margin:0; padding:0; position:relative; box-sizing:border-box;">

                        <!-- ================= QUOTE DETAILS + QUOTATION IMAGE ================= -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:3mm; font-size:9pt;">
                            <tr>
                                <!-- LEFT: Quote To -->
                                <td style="width:45%; vertical-align:top; padding-right:6px;">
                                    <span style="font-weight:700; color:#000;">Quote To:</span>
                                    <br/>
                                    <span t-field="doc.partner_id.name"/>
                                    <br/>
                                    <t t-if="doc.partner_id.street">
                                        <span t-field="doc.partner_id.street"/>
                                        <br/>
                                    </t>
                                    <t t-if="doc.partner_id.city">
                                        <span t-field="doc.partner_id.city"/>
                                        <br/>
                                    </t>
                                    <t t-if="doc.partner_id.country_id">
                                        <span t-field="doc.partner_id.country_id"/>
                                    </t>
                                </td>

                                <!-- MIDDLE: Quote Info -->
                                <td style="width:43%; vertical-align:top;">
                                    <table style="width:100%; border-collapse:collapse; font-size:9pt;">
                                        <tr>
                                            <td style="width:42%; padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Quote Num:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Quote Date:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.date_order"
                                                      t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Reference:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.client_order_ref"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Payment Terms:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.payment_term_id"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Valid Until:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="doc.validity_date"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>

                                <!-- RIGHT: QUOTATION IMAGE -->
                                <td style="width:12%; vertical-align:top; text-align:right; padding-right:0mm;">
                                    <img t-att-src="quotation_b64"
                                         style="width:85%; height:auto; display:block; margin-left:auto;"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ================= SUBJECT ================= -->
                        <p style="margin:0 0 3mm 0; font-size:9pt; font-weight:700; color:#000;">
                            SUBJECT:
                            <span t-field="doc.x_studio_text_field_7ne_1jfb00rqi" style="font-weight:700;"/>
                        </p>

                        <!-- ================= ORDER LINES TABLE ================= -->
                        <table style="width:100%; border-collapse:collapse; font-size:9pt; margin-bottom:4mm;">
                            <thead>
                                <tr style="border-bottom:1.5px solid #3f403e;">
                                    <th style="text-align:left; padding:3px 4px 3px 0; width:48%; font-weight:700; color:#000;">
                                        Description
                                    </th>
                                    <th style="text-align:center; padding:3px 4px; width:14%; font-weight:700; color:#000;">
                                        Quantity
                                    </th>
                                    <th style="text-align:right; padding:3px 4px; width:17%; font-weight:700; color:#000;">
                                        Unit Price
                                    </th>
                                    <th style="text-align:right; padding:3px 0 3px 4px; width:21%; font-weight:700; color:#000;">
                                        Amount RM
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <tr>
                                        <td style="padding:3px 4px 3px 0; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="padding:3px 4px; text-align:center; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_uom_id"/>
                                        </td>
                                        <td style="padding:3px 4px; text-align:right; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td style="padding:3px 0 3px 4px; text-align:right; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ================= TERMS & CONDITIONS ================= -->
                        <p style="margin:0 0 1.5mm 0; font-size:9pt; font-weight:700; color:#000;">
                            TERMS &amp; CONDITIONS
                        </p>

                        <table style="width:100%; border-collapse:collapse; margin-bottom:3mm;">
                            <tr>
                                <td style="width:56%; vertical-align:top; padding-right:8px; font-size:6pt; line-height:1.45; color:#3f403e;">
                                    1. Thank you for the opportunity to serve you. We look forward to meeting with you again.
                                    <br/>
                                    2. <strong><span t-field="doc.company_id.name"/></strong> is dedicated to Quality products of Industrial Standards.
                                    <br/>
                                    3. All Price Quotes are valid until the expiry date mentioned above.
                                    <br/>
                                    4. Purchase Order and Deposit of 50% must be made to process the Quotation.
                                </td>

                                <td style="width:44%; vertical-align:top;">
                                    <table style="width:100%; border-collapse:collapse; font-size:9pt;">
                                        <tr>
                                            <td style="padding:2px 8px 2px 0; font-weight:700; color:#000;">Subtotal</td>
                                            <td style="padding:2px 0; font-weight:700; color:#000; text-align:right; white-space:nowrap;">
                                                <span t-field="doc.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px 8px 2px 0; color:#3f403e;">Tax</td>
                                            <td style="padding:2px 0; text-align:right; white-space:nowrap; color:#3f403e;">
                                                <span t-field="doc.amount_tax"/>
                                            </td>
                                        </tr>
                                        <tr style="border-top:1px solid #3f403e;">
                                            <td style="padding:3px 8px 2px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Total Amount
                                            </td>
                                            <td style="padding:3px 0 2px 0; font-weight:700; color:#000; text-align:right; white-space:nowrap;">
                                                <span t-field="doc.amount_total"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- ================= END OF INVOICE ================= -->
                        <p style="text-align:center; font-size:9pt; font-weight:700; color:#000; margin:5mm 0;">
                            End of Invoice Lines
                        </p>

                        <!-- ================= SIGNATURE ================= -->
                        <div style="margin-top:15mm; font-size:8.5pt; color:#3f403e;">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <!-- Receiver - Left side -->
                                    <td style="width:50%; vertical-align:bottom;">
                                        <div>
                                            <div style="border-top:1px dashed #3f403e; margin-bottom:3px; width:80%;"/>
                                            Receiver's Signatory (Sign and Chop)
                                        </div>
                                    </td>

                                    <!-- Authorized Signatory with Seal - Right side -->
                                    <td style="width:50%; vertical-align:bottom; text-align:right;">
                                        <div>
                                            <img t-att-src="seal_b64"
                                                 style="width:40mm; height:40mm; display:block; margin-bottom:5px; margin-left:auto;"/>
                                            <div style="border-top:1px dashed #3f403e; margin-bottom:3px; width:80%; margin-left:auto;"/>
                                            Authorized Signatory
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>