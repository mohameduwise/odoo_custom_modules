<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_quotation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <t t-set="is_layang"
                   t-value="'LAYANG' in (o.company_id.name or '').upper()"/>
                <t t-set="header_b64"
                   t-value="o._get_report_image_b64('header_layang.png') if is_layang else o._get_report_image_b64('header_insytx.png')"/>
                <t t-set="footer_b64"
                   t-value="o._get_report_image_b64('footer_layang.png') if is_layang else o._get_report_image_b64('footer_insytx.png')"/>
                <t t-set="label_color"
                   t-value="'#c0392b' if is_layang else '#e08020'"/>

                <div class="page" style="
    font-family: 'Urbanist', 'Arial', sans-serif;
    font-size: 9pt;
    color: #3f403e;
    margin: 0;
    padding: 0;
    position: relative;
    box-sizing: border-box;">

                    <!-- FOOTER fixed at bottom -->
                    <div style="position:fixed; bottom:0; left:0; right:0; background:#fff; z-index:99;">
                        <t t-if="is_layang">
                            <img t-att-src="footer_b64"
                                 style="display:block; width:90%; margin:0 auto 4px auto;"/>
                        </t>
                        <t t-else="">
                            <img t-att-src="footer_b64"
                                 style="display:block; width:100%;"/>
                        </t>
                    </div>

                    <!-- HEADER flush to top -->
                    <img t-att-src="header_b64" style="width:100%; display:block; margin:0; padding:0;"/>

                    <!-- CONTENT -->
                    <div style="padding: 5mm 28px 30mm 10mm;">

                        <!-- QUOTE TO + QUOTE DETAILS -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:4mm; font-size:9pt;">
                            <tr>
                                <td style="width:50%; vertical-align:top; padding-right:6px;">
                                    <span style="font-weight:700; color:#000;">Quote To:</span>
                                    <br/>
                                    <span t-field="o.partner_id.name"/>
                                    <br/>
                                    <t t-if="o.partner_id.street">
                                        <span t-field="o.partner_id.street"/>
                                        <br/>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <span t-field="o.partner_id.city"/>
                                        <br/>
                                    </t>
                                    <t t-if="o.partner_id.country_id">
                                        <span t-field="o.partner_id.country_id"/>
                                    </t>
                                </td>
                                <td style="width:50%; vertical-align:top;">
                                    <table style="width:100%; border-collapse:collapse; font-size:9pt;">
                                        <tr>
                                            <td style="width:42%; padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Quote Num:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="o.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Quote Date:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="o.date_order" t-options='{"widget":"date"}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Reference:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="o.client_order_ref"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Payment Terms:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="o.payment_term_id"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:1px 6px 1px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Valid Until:
                                            </td>
                                            <td style="padding:1px 0;">
                                                <span t-field="o.validity_date"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- SUBJECT -->
                        <p style="margin:0 0 3mm 0; font-size:9pt; font-weight:700; color:#000;">
                            SUBJECT:
                            <span t-field="o.x_studio_text_field_7ne_1jfb00rqi" style="font-weight:700;"/>
                        </p>

                        <!-- ORDER LINES TABLE -->
                        <table style="width:100%; border-collapse:collapse; font-size:9pt; margin-bottom:4mm;">
                            <thead>
                                <tr style="border-bottom:1.5px solid #3f403e;">
                                    <th style="text-align:left; padding:3px 4px 3px 0; width:48%; font-weight:700; color:#000;">
                                        Description
                                    </th>
                                    <th style="text-align:center; padding:3px 4px; width:14%; font-weight:700; color:#000;">
                                        Quantity
                                    </th>
                                    <th style="text-align:right; padding:3px 4px; width:17%; font-weight:700; color:#000;">
                                        Unit Price
                                    </th>
                                    <th style="text-align:right; padding:3px 0 3px 4px; width:21%; font-weight:700; color:#000;">
                                        Amount RM
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.order_line" t-as="line">
                                    <tr>
                                        <td style="padding:3px 4px 3px 0; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="padding:3px 4px; text-align:center; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_uom_id"/>
                                        </td>
                                        <td style="padding:3px 4px; text-align:right; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td style="padding:3px 0 3px 4px; text-align:right; vertical-align:top; border-bottom:0.5px solid #e8e8e8;">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <br/>
                        <!-- ── TERMS & CONDITIONS heading ──────────────────────────── -->
                        <p style="margin:0 0 1.5mm 0; font-size:9pt; font-weight:700; color:#000;">
                            TERMS &amp; CONDITIONS
                        </p>

                        <!-- ── TERMS LEFT + TOTALS RIGHT ───────────────────────────── -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:3mm;">
                            <tr>
                                <!-- Terms: 4 lines, compact -->
                                <td style="width:56%; vertical-align:top; padding-right:8px;
                            font-size:6pt; line-height:1.45; color:#3f403e;">
                                    1. Thank you for the opportunity to serve you. We look forward to meeting with you
                                    again.
                                    <br/>
                                    2.
                                    <strong>
                                        <span t-field="o.company_id.name"/>
                                    </strong>
                                    is dedicated to Quality products of Industrial Standards.
                                    <br/>
                                    3. All Price Quotes are valid until the expiry date mentioned above.
                                    <br/>
                                    4. Purchase Order and Deposit of 50% must be made to process the Quotation.
                                </td>

                                <!-- Totals: right-aligned, white-space:nowrap prevents wrapping -->
                                <td style="width:44%; vertical-align:top;">
                                    <table style="width:100%; border-collapse:collapse; font-size:9pt;">
                                        <tr>
                                            <td style="padding:2px 8px 2px 0; font-weight:700; color:#000;">
                                                Subtotal
                                            </td>
                                            <td style="padding:2px 0; font-weight:700; color:#000;
                                       text-align:right; white-space:nowrap;">
                                                RM
                                                <span t-field="o.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px 8px 2px 0; color:#3f403e;">Tax</td>
                                            <td style="padding:2px 0; text-align:right;
                                       white-space:nowrap; color:#3f403e;">
                                                RM
                                                <span t-field="o.amount_tax"/>
                                            </td>
                                        </tr>
                                        <tr style="border-top:1px solid #3f403e;">
                                            <td style="padding:3px 8px 2px 0; font-weight:700; color:#000; white-space:nowrap;">
                                                Total Amount
                                            </td>
                                            <td style="padding:3px 0 2px 0; font-weight:700; color:#000;
                                       text-align:right; white-space:nowrap;">
                                                RM
                                                <span t-field="o.amount_total"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- END OF INVOICE LINES -->
                        <br/>
                        <br/>
                        <p style="text-align:center; font-size:9pt; font-weight:700; color:#000; margin:5mm 0;">
                            End of Invoice Lines
                        </p>

                        <!-- SIGNATURE LINES -->
                        <div style="margin-top:20mm; font-size:8.5pt; color:#3f403e;">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="width:42%; vertical-align:bottom;">
                                        <div style="border-top:1px dashed #3f403e; margin-bottom:3px;"/>
                                        Receiver's Signatory (Sign and Chop)
                                    </td>
                                    <td style="width:16%;"/>
                                    <td style="width:42%; text-align:right; vertical-align:bottom;">
                                        <div style="border-top:1px dashed #3f403e; margin-bottom:3px;"/>
                                        Authorized Signatory
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="text-align:center; font-size:8pt; color:#888; padding-bottom:2px;">
                                    Page
                                    <t t-esc="o_index + 1"/>
                                    of
                                    <t t-esc="o_size"/>
                                </td>
                            </tr>
                        </table>

                    </div><!-- /content -->
                </div><!-- /page -->
            </t>
        </t>
    </template>
</odoo>