<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="external_layout_standard_digital" inherit_id="web.external_layout_standard">
            <xpath expr="//div[1]" position="replace">
                <div style="" class="header row">
                    <div style="">
                        <div style="width:100%;">
                            <!-- LEFT 30% -->
                            <div style="width:100%;text-align:center;">
                                <img src="/digital_infotech_report/static/src/img/digital_instyx_header_crop.png"
                                      style="width:100%;"
                                     alt="Logo"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <!-- Replace Footer -->
            <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}"
                 position="replace">
                <div class="footer" style="padding-top:55px">
<!--                <div class="footer">-->
                    <div style="display:table; width:100%;">

<!--                        &lt;!&ndash; LEFT SECTION &ndash;&gt;-->
                        <div style="display:table-cell;width:35%; text-align:left;">
                        </div>

                        <!-- CENTER SECTION -->
                        <div style="display:table-cell; width:30%; text-align:center;">
                            <br/>
                            Page
                            <span class="page"/>
                            of
                            <span class="topage"/>
                        </div>

<!--                        &lt;!&ndash; RIGHT SECTION &ndash;&gt;-->
                        <div style="display:table-cell; width:35%; text-align:right;">
                            <div style="text-align:right;margin-top:2px">
                                <img src="/digital_infotech_report/static/src/img/digital_instyx_footer.jpeg"
                                      style="height:70px; width:100px;"
                                     alt="Logo"/>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </template>


        <record id="paperformat_digital_customer_report" model="report.paperformat">
            <field name="name">Digital Info sale order paperformat</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <!-- Header & Footer Heights -->
            <field name="margin_top">32</field>        <!-- Header height -->
            <field name="margin_bottom">30</field>     <!-- Footer height -->
            <!-- Side Margins -->
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <!-- Header Settings -->
            <field name="header_line" eval="False"/>
            <field name="header_spacing">22</field>     <!-- Keep 0 to avoid extra space -->
            <field name="dpi">90</field>
        </record>

        <record id="action_report_saleorder_digital" model="ir.actions.report">
            <field name="name">Digital Info Quotation / Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">digital_infotech_report.report_saleorder_digital</field>
            <field name="report_file">digital_infotech_report.report_saleorder_digital</field>
            <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="digital_infotech_report.paperformat_digital_customer_report"/>
        </record>

